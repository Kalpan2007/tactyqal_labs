# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Both strings come from: Supabase project → Connect → ORMs → Prisma
#
# DATABASE_URL = Transaction pooler, port 6543. Used by the running app.
#                Serverless functions open and drop connections constantly,
#                which is what this pooler is for.
# DIRECT_URL   = Session pooler, port 5432. Used by `prisma migrate` and the
#                import scripts, which need a real session.
#
# IMPORTANT — use the *session pooler* host for DIRECT_URL, not the
# "direct connection" host (db.[PROJECT-REF].supabase.co). Supabase's direct
# host resolves to IPv6 only unless you buy the IPv4 add-on, so on a normal
# IPv4 network it fails with "P1001: Can't reach database server".
# Both URLs therefore share the same pooler hostname and differ only in port.
#
# Replace [PROJECT-REF], [PASSWORD] and [REGION] with your own values, and
# copy the hostname from the dashboard — the prefix may be aws-0 or aws-1.
#
# URL-encode the password if it contains any of @ : / ? # & — for example
# @ becomes %40. An unencoded @ silently breaks the host part of the URL.
#
# `uselibpqcompat=true` is required: without it, pg v8.16+ treats
# sslmode=require as full CA verification and rejects the pooler's
# certificate chain with "self-signed certificate in certificate chain".
# The connection is still TLS-encrypted, it just is not CA-verified.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Local Postgres instead of Supabase (docker compose up -d). Swap these in to
# develop offline; everything else works the same.
# DATABASE_URL="postgresql://tactyqal:tactyqal@localhost:5433/tactyqal?schema=public"
# DIRECT_URL="postgresql://tactyqal:tactyqal@localhost:5433/tactyqal?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Protects every write endpoint (POST/PATCH/DELETE) and the /admin UI.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY="change-me-in-production"

# Absolute origin. Used for canonical URLs, the sitemap and Open Graph tags.
# In production set this to the real domain, e.g. https://tactyqal-labs.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Source blog for `npm run db:import`. Defaults to the live Tactyqal blog.
# WORDPRESS_API_URL="https://tactyqal.com/blog/wp-json/wp/v2"

# How many posts `npm run db:seed` pulls. Leave unset for the default of 60.
# SEED_POST_COUNT="60"
